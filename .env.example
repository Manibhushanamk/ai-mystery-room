NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1

# Database: Neon Serverless Postgres (Recommended) or MongoDB
# Set DATABASE_URL with your Neon Postgres connection string:
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# LLM Providers: Groq (Ultra-Fast) or Gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LLM_PROVIDER=auto

SESSION_SECRET=dev_session_secret_change_in_production
COOKIE_SECURE=false

# Optional: persistent asset store
ASSET_STORAGE_PROVIDER=local
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_ACCESS_KEY=
ASSET_STORAGE_SECRET_KEY=

LOG_LEVEL=info
CASE_GENERATION_TIMEOUT_MS=90000
MAX_CASES_PER_HOUR=10
